%   plurals_with_di_and_d_19     ʔùl — grammar: "Plurals with [-di] and [-dɪ]"
%   amba_type                    ʔāmbá
%   plurals_with_i_and_10        ʔīsō — grammar: "Plurals with [-i] and [-ɪ]"
