% rules/fi/pronouns.lp
% Finnish personal pronouns (features: case, number); personal pronouns have a
% distinct accusative (minut, hänet). Every form is listed.

form("minä", "case=nominative;number=singular", "minä"). form("minä", "case=genitive;number=singular", "minun"). form("minä", "case=partitive;number=singular", "minua"). form("minä", "case=accusative;number=singular", "minut"). form("minä", "case=inessive;number=singular", "minussa"). form("minä", "case=elative;number=singular", "minusta"). form("minä", "case=illative;number=singular", "minuun"). form("minä", "case=adessive;number=singular", "minulla"). form("minä", "case=ablative;number=singular", "minulta"). form("minä", "case=allative;number=singular", "minulle"). form("minä", "case=essive;number=singular", "minuna"). form("minä", "case=translative;number=singular", "minuksi").
form("sinä", "case=nominative;number=singular", "sinä"). form("sinä", "case=genitive;number=singular", "sinun"). form("sinä", "case=partitive;number=singular", "sinua"). form("sinä", "case=accusative;number=singular", "sinut"). form("sinä", "case=inessive;number=singular", "sinussa"). form("sinä", "case=elative;number=singular", "sinusta"). form("sinä", "case=illative;number=singular", "sinuun"). form("sinä", "case=adessive;number=singular", "sinulla"). form("sinä", "case=ablative;number=singular", "sinulta"). form("sinä", "case=allative;number=singular", "sinulle"). form("sinä", "case=essive;number=singular", "sinuna"). form("sinä", "case=translative;number=singular", "sinuksi").
form("hän", "case=nominative;number=singular", "hän"). form("hän", "case=genitive;number=singular", "hänen"). form("hän", "case=partitive;number=singular", "häntä"). form("hän", "case=accusative;number=singular", "hänet"). form("hän", "case=inessive;number=singular", "hänessä"). form("hän", "case=elative;number=singular", "hänestä"). form("hän", "case=illative;number=singular", "häneen"). form("hän", "case=adessive;number=singular", "hänellä"). form("hän", "case=ablative;number=singular", "häneltä"). form("hän", "case=allative;number=singular", "hänelle"). form("hän", "case=essive;number=singular", "hänenä"). form("hän", "case=translative;number=singular", "häneksi").
form("me", "case=nominative;number=plural", "me"). form("me", "case=genitive;number=plural", "meidän"). form("me", "case=partitive;number=plural", "meitä"). form("me", "case=accusative;number=plural", "meidät"). form("me", "case=inessive;number=plural", "meissä"). form("me", "case=elative;number=plural", "meistä"). form("me", "case=illative;number=plural", "meihin"). form("me", "case=adessive;number=plural", "meillä"). form("me", "case=ablative;number=plural", "meiltä"). form("me", "case=allative;number=plural", "meille"). form("me", "case=essive;number=plural", "meinä"). form("me", "case=translative;number=plural", "meiksi").
form("te", "case=nominative;number=plural", "te"). form("te", "case=genitive;number=plural", "teidän"). form("te", "case=partitive;number=plural", "teitä"). form("te", "case=accusative;number=plural", "teidät"). form("te", "case=inessive;number=plural", "teissä"). form("te", "case=elative;number=plural", "teistä"). form("te", "case=illative;number=plural", "teihin"). form("te", "case=adessive;number=plural", "teillä"). form("te", "case=ablative;number=plural", "teiltä"). form("te", "case=allative;number=plural", "teille"). form("te", "case=essive;number=plural", "teinä"). form("te", "case=translative;number=plural", "teiksi").
form("he", "case=nominative;number=plural", "he"). form("he", "case=genitive;number=plural", "heidän"). form("he", "case=partitive;number=plural", "heitä"). form("he", "case=accusative;number=plural", "heidät"). form("he", "case=inessive;number=plural", "heissä"). form("he", "case=elative;number=plural", "heistä"). form("he", "case=illative;number=plural", "heihin"). form("he", "case=adessive;number=plural", "heillä"). form("he", "case=ablative;number=plural", "heiltä"). form("he", "case=allative;number=plural", "heille"). form("he", "case=essive;number=plural", "heinä"). form("he", "case=translative;number=plural", "heiksi").
