% rules/xnq/nouns.lp
% Mozambican Ngoni (Xingoni) nouns: generated from grammars in the DocumentCatalog (tools/grammar_rules; LLM-
% extracted paradigms, classes induced from them). Review before relying on it.
%
% Sources (document id in the DocumentCatalog):
%   doc 37610: A Descriptive Grammar of Mozambican Ngoni (Xingoni) (2024), pages 78, 79, 84, 85, 112, 196, 202
%
% Classes (noun_class/2 in data/nouns.lexicon.tsv, affixes in data/nouns.paradigms.tsv):
%   class_1_and_2_respectful_family_terms ahana — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_2 ahôkolo — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_3 ambuja — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_4 amma — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_5 anahenga — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_6 angana — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_7 anjômba — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_8 anyongo — grammar: "Class 1 and 2 respectful family terms"
%   class_1_and_2_respectful_family_terms_9 atati — grammar: "Class 1 and 2 respectful family terms"
%   class_9_10_without_nasal_onset haka — grammar: "class 9/10 without nasal onset"
%   class_9_10_without_nasal_onset_2 hingwa — grammar: "class 9/10 without nasal onset"
%   class_9_10_without_nasal_onset_3 hitu — grammar: "class 9/10 without nasal onset"
%   class_9_10_without_nasal_onset_4 hêga — grammar: "class 9/10 without nasal onset"
%   class_9_10_without_nasal_onset_5 jigu — grammar: "class 9/10 without nasal onset"
%   class_9_10_without_nasal_onset_6 kangwa — grammar: "class 9/10 without nasal onset"
%   class_9_nouns_with_plural_class_6 kaya — grammar: "class 9 nouns with plural class 6"
%   nouns_in_class_11_with_plural_class_10 luhanju — grammar: "nouns in class 11 with plural class 10"
%   nouns_in_class_11_with_plural_class_10_2 luhundu — grammar: "nouns in class 11 with plural class 10"
%   nouns_in_class_11_with_plural_class_10_w luhwani — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_2 lukemba — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_3 lulôhe — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_3 lundondwa — grammar: "nouns in class 11 with plural class 10"
%   nouns_in_class_11_with_plural_class_10_4 lungônde — grammar: "nouns in class 11 with plural class 10"
%   nouns_in_class_11_with_plural_class_10_5 lunjuxi — grammar: "nouns in class 11 with plural class 10"
%   nouns_in_class_11_with_plural_class_10_w_4 lupanja — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_5 lupia — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_6 lupundi — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_7 lutahi — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_8 lutatambui — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_9 lutiku — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_w_10 luvani — grammar: "nouns in class 11 with plural class 10 with nasal assimilation"
%   nouns_in_class_11_with_plural_class_10_6 luyuda — grammar: "nouns in class 11 with plural class 10"
%   animal_names_in_class_9_10   mbaka — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_2 mbuhi — grammar: "animal names in class 9/10"
%   class_1_and_2                mmanda — grammar: "Class 1 and 2"
%   class_1_and_2_2              munahota — grammar: "Class 1 and 2"
%   class_1_and_2_3              munalôme — grammar: "Class 1 and 2"
%   class_1_and_2_4              mundu — grammar: "Class 1 and 2"
%   class_1_and_2_5              mwana — grammar: "Class 1 and 2"
%   other_family_terms           mwikêge — grammar: "other family terms"
%   other_family_terms_2         mwipa — grammar: "other family terms"
%   animal_names_in_class_9_10_3 ndembu — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_4 ndomondo — grammar: "animal names in class 9/10"
%   class_9_nouns_with_plural_class_6_2 ndêla — grammar: "class 9 nouns with plural class 6"
%   other_family_terms_3         nganja — grammar: "other family terms"
%   class_1_and_2_6              ngeni — grammar: "Class 1 and 2"
%   animal_names_in_class_9_10_5 ngimbwa — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_6 ngunda — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_7 ngwai — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_8 ngôko — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_9 ng’ombe — grammar: "animal names in class 9/10"
%   class_1_and_2_7              njau — grammar: "Class 1 and 2"
%   animal_names_in_class_9_10_10 njegeja — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_11 njenjema — grammar: "animal names in class 9/10"
%   animal_names_in_class_9_10_12 njivila — grammar: "animal names in class 9/10"
%   other_family_terms_4         nkohanu — grammar: "other family terms"
%   class_1_and_2_8              nkêva — grammar: "Class 1 and 2"
%   other_family_terms_5         nkôlo — grammar: "other family terms"
%   other_family_terms_6         nnamu — grammar: "other family terms"
%   class_1_and_2_9              nnaxu — grammar: "Class 1 and 2"
%   other_family_terms_7         nng’anu — grammar: "other family terms"
%   class_1_and_2_10             nng’avi — grammar: "Class 1 and 2"
%   other_family_terms_8         nng’inja — grammar: "other family terms"
%   other_family_terms_9         nnongu — grammar: "other family terms"
%   other_family_terms_10        nnung’una — grammar: "other family terms"
%   other_family_terms_11        nnômbo — grammar: "other family terms"
%   class_1_and_2_11             ntamaji — grammar: "Class 1 and 2"
%   class_1_and_2_12             nxanda — grammar: "Class 1 and 2"
%   animal_names_in_class_9_10_13 nyama — grammar: "animal names in class 9/10"
%   class_9_nouns_with_plural_class_6_3 nyumba — grammar: "class 9 nouns with plural class 6"
%   class_9_10_without_nasal_onset_7 pinga — grammar: "class 9/10 without nasal onset"
%   animal_names_in_class_9_10_14 wala — grammar: "animal names in class 9/10"
%
% Not covered: anything the selected grammar pages do not show as a full paradigm;
% a class is only as complete as the forms the grammar printed for its members.

form(L, Key, @affix(L, Front, Prefix, Strip, Ending)) :- input_lemma(L),
    noun_class(L, Class), paradigm_affix(Class, Key, Front, Prefix, Strip, Ending), not irregular(L).
