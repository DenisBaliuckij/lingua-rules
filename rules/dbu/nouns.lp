%   ti_type                      tǐ
%   xx3_b_5                      tɔ́mbɛ̀ — grammar: "xx3.b (ɛ↔ɔ)"
%   til_type                     tɛ̀ŋílɛ̀
%   wole_type                    wole
%   ya_pande_type                yà-pàndé
%   yaba_dndl_type               yàbà-dɔ́ndɔ́lɔ́
%   sg_pl_e_e_class_inanimates_5 yàlî — grammar: "Sg = Pl, E/E-class inanimates"
%   yayge_type                   yàygé
%   xx4_a_awo_with_shift_in_vowel_harmonic_c_3 yɛ̌ — grammar: "xx4.a (ɛ:↔awo: with shift in vowel-harmonic class)"
%   ajabale_type                 àjàbàlé
%   almu_jini_type               àlmú:jìnì
%   xx3_b_6                      àndàmɛ̂ — grammar: "xx3.b (ɛ↔ɔ)"
%   pl_mbo_true_animates_e_o_5   àndàsárá — grammar: "Pl -mbo, true animates (E/O)"
%   sg_pl_e_e_class_inanimates_6 ólé — grammar: "Sg = Pl, E/E-class inanimates"
%   xx4_a_awo_with_shift_in_vowel_harmonic_c_4 ùbùlŋgɛ́ — grammar: "xx4.a (ɛ:↔awo: with shift in vowel-harmonic class)"
%   usp_type                     ùspɔ̌
%   uju_type                     újù
%   gw_type                      ŋgwɛ̌
%   pl_mbo_true_animates_e_o_6   ŋ̀gwɛ̌ — grammar: "Pl -mbo, true animates (E/O)"
%   oye_type                     ǒyè
%   j_type                       ɔ̀jɔ̌
%   alale_type                   ɲàlàlé
%   sg_pl_e_e_class_inanimates_7 ɲám — grammar: "Sg = Pl, E/E-class inanimates"
%
% Not covered: anything the selected grammar pages do not show as a full paradigm;
% a class is only as complete as the forms the grammar printed for its members.

form(L, Key, @strip_suffix_add(L, Strip, Ending)) :- input_lemma(L),
    noun_class(L, Class), paradigm_ending(Class, Key, Strip, Ending), not irregular(L).
